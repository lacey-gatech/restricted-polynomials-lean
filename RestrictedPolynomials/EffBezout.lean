import RestrictedPolynomials.QuantDefs
import Mathlib.LinearAlgebra.Matrix.DotProduct
import Mathlib.LinearAlgebra.Matrix.AbsoluteValue

/-!
# The effective Bézout identity (formula (5.12) of the paper)

If `D` lies in the `ℚ[z]`-ideal generated by `Δ_1, …, Δ_t ∈ ℤ[z]`, one of which is monic of
degree `≥ deg D`, then `B · D = ∑ V_i Δ_i` with `V_i ∈ ℤ[z]` and a positive integer `B`
bounded explicitly in terms of the degrees and coefficients of the `Δ_i`.

Proof sketch: reduce the Bézout coefficients to degree `< n` (division by the monic `Δ_{i₀}`);
this is a linear system `C x = b` with integer matrix `C` of `2n` rows whose columns are the
coefficient vectors of `z^j Δ_i`. Choose a maximal linearly independent set of columns `C_S`;
then `v = (C_Sᵀ C_S)⁻¹ C_Sᵀ b` and `B = |det (C_Sᵀ C_S)|` works, with `B` bounded by
`det_le` (Hadamard-type bound `n! x^n` for the entries).
-/

open Finset Polynomial Matrix

noncomputable section

namespace RestrictedPolynomials

lemma bezout_reduce {t : ℕ} (Δ : Fin t → ℤ[X]) (n : ℕ) (hn : 1 ≤ n) (i₀ : Fin t)
    (hmonic : (Δ i₀).Monic) (hdeg : ∀ i, (Δ i).natDegree ≤ n)
    (D : ℤ[X]) (hDdeg : D.natDegree ≤ (Δ i₀).natDegree)
    (U : Fin t → ℚ[X]) (hU : toQ D = ∑ i, U i * toQ (Δ i)) :
    ∃ W : Fin t → ℚ[X], (∀ i, (W i).natDegree < n) ∧ toQ D = ∑ i, W i * toQ (Δ i) := by
  classical
  set Δ' : ℚ[X] := toQ (Δ i₀) with hΔ'
  have hm : Δ'.Monic := hmonic.map _
  have hd : Δ'.natDegree = (Δ i₀).natDegree := hmonic.natDegree_map _
  have hne : Δ' ≠ 0 := hm.ne_zero
  set d := (Δ i₀).natDegree with hdd
  have hdn : d ≤ n := hdeg i₀
  let W : Fin t → ℚ[X] := fun i => if i = i₀ then
    U i₀ + ∑ j ∈ univ.erase i₀, (U j /ₘ Δ') * toQ (Δ j) else U i %ₘ Δ'
  have hWne : ∀ i, i ≠ i₀ → W i = U i %ₘ Δ' := fun i hi => by simp [W, hi]
  have hW0 : W i₀ = U i₀ + ∑ j ∈ univ.erase i₀, (U j /ₘ Δ') * toQ (Δ j) := by simp [W]
  have key : ∑ i, W i * toQ (Δ i) = ∑ i, U i * toQ (Δ i) := by
    rw [← Finset.add_sum_erase _ _ (mem_univ i₀),
      ← Finset.add_sum_erase _ (fun i => U i * toQ (Δ i)) (mem_univ i₀), hW0, add_mul,
      Finset.sum_mul, add_assoc]
    congr 1
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [hWne i (Finset.ne_of_mem_erase hi)]
    have := modByMonic_add_div (U i) Δ'
    rw [← hΔ']
    linear_combination (toQ (Δ i)) * this
  have hR : ∀ i, i ≠ i₀ → W i = 0 ∨ (W i).natDegree + 1 ≤ d := by
    intro i hi
    rw [hWne i hi]
    by_cases h0 : U i %ₘ Δ' = 0
    · exact Or.inl h0
    · refine Or.inr ?_
      have h1 := degree_modByMonic_lt (U i) hm
      rw [degree_eq_natDegree hne, hd] at h1
      have h2 := (natDegree_lt_iff_degree_lt h0).2 h1
      omega
  have hprod : (W i₀ * Δ').natDegree ≤ n + d - 1 := by
    have e : W i₀ * Δ' = toQ D - ∑ i ∈ univ.erase i₀, W i * toQ (Δ i) := by
      have := key
      rw [← Finset.add_sum_erase _ _ (mem_univ i₀)] at this
      rw [hU, ← key, ← Finset.add_sum_erase _ _ (mem_univ i₀)]
      ring
    rw [e]
    refine (natDegree_sub_le _ _).trans (max_le ?_ ?_)
    · have h1 : (toQ D).natDegree ≤ D.natDegree := natDegree_map_le
      omega
    · refine natDegree_sum_le_of_forall_le _ _ fun i hi => ?_
      have h2 : (toQ (Δ i)).natDegree ≤ n := natDegree_map_le.trans (hdeg i)
      rcases hR i (Finset.ne_of_mem_erase hi) with h1 | h1
      · rw [h1, zero_mul, natDegree_zero]; exact Nat.zero_le _
      · refine natDegree_mul_le.trans ?_
        omega
  refine ⟨W, ?_, key.symm ▸ hU⟩
  intro i
  by_cases hi : i = i₀
  · subst hi
    by_cases h0 : W i = 0
    · rw [h0, natDegree_zero]; omega
    · have := (hm.natDegree_mul' h0)
      rw [mul_comm] at hprod
      rw [this] at hprod
      omega
  · rcases hR i hi with h1 | h1
    · rw [h1, natDegree_zero]; omega
    · omega

lemma cramer_int {m ρ : Type*} [Fintype m] [Fintype ρ] [DecidableEq ρ]
    (M : Matrix m ρ ℤ) (b : m → ℤ) (v : ρ → ℚ)
    (hv : (M.map (Int.castRingHom ℚ)) *ᵥ v = fun r => (b r : ℚ)) :
    ∃ z : ρ → ℤ, ∀ s, (z s : ℚ) = ((Mᵀ * M).det : ℚ) * v s := by
  refine ⟨(Mᵀ * M).adjugate *ᵥ (Mᵀ *ᵥ b), fun s => ?_⟩
  set f := Int.castRingHom ℚ with hf
  set G := Mᵀ * M with hG
  have h1 : (f ((G.adjugate *ᵥ (Mᵀ *ᵥ b)) s)) = ((G.adjugate.map f) *ᵥ (f ∘ (Mᵀ *ᵥ b))) s :=
    RingHom.map_mulVec f _ _ s
  have h2 : (f ∘ (Mᵀ *ᵥ b)) = (Mᵀ.map f) *ᵥ (f ∘ b) := by
    funext r
    exact RingHom.map_mulVec f _ _ r
  have h3 : G.adjugate.map f = adjugate (G.map f) := by
    have := f.map_adjugate G
    exact this
  have h4 : G.map f = (M.map f)ᵀ * M.map f := by
    rw [hG, Matrix.map_mul, Matrix.transpose_map]
  have h5 : (f ∘ b) = fun r => (b r : ℚ) := by funext r; simp [hf]
  have h6 : f (G.det) = (G.map f).det := f.map_det G
  show f ((G.adjugate *ᵥ (Mᵀ *ᵥ b)) s) = f G.det * v s
  have h7 : Mᵀ.map f *ᵥ (M.map f *ᵥ v) = G.map f *ᵥ v := by
    rw [Matrix.mulVec_mulVec, ← Matrix.map_mul]
  rw [h1, h2, h3, h5, h6, ← hv, h7, Matrix.mulVec_mulVec, Matrix.adjugate_mul]
  simp [Matrix.smul_mulVec]

lemma bezout_linalg {t : ℕ} (Δ : Fin t → ℤ[X]) (n x : ℕ) (hn : 1 ≤ n) (hx : 1 ≤ x)
    (hdeg : ∀ i, (Δ i).natDegree ≤ n) (hcoeff : ∀ i j, |(Δ i).coeff j| ≤ x)
    (D : ℤ[X]) (hD : D.natDegree ≤ n)
    (W : Fin t → ℚ[X]) (hW : ∀ i, (W i).natDegree < n)
    (h : toQ D = ∑ i, W i * toQ (Δ i)) :
    ∃ B : ℕ, 0 < B ∧ B ≤ (2 * n).factorial * (2 * n * x ^ 2) ^ (2 * n) ∧
      ∃ V : Fin t → ℤ[X], ∑ i, V i * Δ i = C (B : ℤ) * D := by
  classical
  let f := Int.castRingHom ℚ
  let P : Fin t × Fin n → ℤ[X] := fun k => X ^ (k.2 : ℕ) * Δ k.1
  have hPdeg : ∀ k, (P k).natDegree < 2 * n := by
    intro k
    have h1 := natDegree_mul_le (p := (X : ℤ[X]) ^ (k.2 : ℕ)) (q := Δ k.1)
    rw [natDegree_X_pow] at h1
    have := k.2.2
    have := hdeg k.1
    simp only [P]
    omega
  have hPco : ∀ k r, |(P k).coeff r| ≤ x := by
    intro k r
    simp only [P]
    rw [coeff_X_pow_mul']
    split_ifs
    · exact hcoeff _ _
    · simp
  let w0 : Fin t × Fin n → ℚ := fun k => (W k.1).coeff k.2
  have hA : toQ D = ∑ k : Fin t × Fin n, C (w0 k) * toQ (P k) := by
    rw [h, Fintype.sum_prod_type]
    refine sum_congr rfl fun i _ => ?_
    conv_lhs => rw [as_sum_range' (W i) n (hW i), Finset.sum_range]
    rw [Finset.sum_mul]
    refine sum_congr rfl fun j _ => ?_
    rw [← C_mul_X_pow_eq_monomial]
    simp [P, w0]
    ring
  have hcoef : ∀ r, (D.coeff r : ℚ) = ∑ k, w0 k * ((P k).coeff r : ℚ) := by
    intro r
    have := congrArg (fun p => p.coeff r) hA
    simpa [toQ_apply, finsetSum_coeff, coeff_C_mul, coeff_map] using this
  let cols : Fin t × Fin n → (Fin (2 * n) → ℚ) := fun k r => ((P k).coeff r : ℚ)
  let bq : Fin (2 * n) → ℚ := fun r => (D.coeff r : ℚ)
  have hb : ∑ k, w0 k • cols k = bq := by
    funext r
    simp [cols, bq, hcoef r, Finset.sum_apply]
  obtain ⟨κ', a, ha, hsp, hli⟩ := exists_linearIndependent' ℚ cols
  have : Finite κ' := Finite.of_injective a ha
  have : Fintype κ' := Fintype.ofFinite κ'
  let M : Matrix (Fin (2 * n)) κ' ℤ := fun r s => (P (a s)).coeff r
  have hmem : bq ∈ Submodule.span ℚ (Set.range (cols ∘ a)) := by
    rw [hsp, ← hb]
    exact Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)
  obtain ⟨v, hv⟩ := (Submodule.mem_span_range_iff_exists_fun ℚ).1 hmem
  have hMv' : ∀ r, ∑ s, (M r s : ℚ) * v s = (D.coeff r : ℚ) := by
    intro r
    have := congrFun hv r
    simp only [Finset.sum_apply, Pi.smul_apply, Function.comp, smul_eq_mul, cols, bq] at this
    rw [← this]
    exact sum_congr rfl fun s _ => mul_comm _ _
  have hMv : (M.map f) *ᵥ v = fun r : Fin (2 * n) => ((D.coeff r : ℤ) : ℚ) := by
    funext r
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply]
    exact hMv' r
  have hdet : (Mᵀ * M).det ≠ 0 := by
    intro h0
    have h0' : ((Mᵀ * M).map f).det = 0 := by
      show (f.mapMatrix (Mᵀ * M)).det = 0
      rw [← f.map_det, h0, map_zero]
    obtain ⟨u, hu0, hu⟩ := Matrix.exists_mulVec_eq_zero_iff.2 h0'
    apply hu0
    rw [Matrix.map_mul, Matrix.transpose_map] at hu
    have h1 : (M.map f *ᵥ u) ⬝ᵥ (M.map f *ᵥ u) = 0 := by
      have : u ⬝ᵥ ((M.map f)ᵀ * M.map f) *ᵥ u = 0 := by rw [hu]; simp
      rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_transpose] at this
      exact this
    have h2 := dotProduct_self_eq_zero.1 h1
    have h3 : ∑ s, u s • (cols ∘ a) s = 0 := by
      funext r
      have := congrFun h2 r
      simp only [Matrix.mulVec, dotProduct, Matrix.map_apply] at this
      simp only [Finset.sum_apply, Pi.smul_apply, Function.comp, smul_eq_mul, cols]
      rw [← this]
      exact sum_congr rfl fun s _ => mul_comm _ _
    exact funext fun s => (Fintype.linearIndependent_iff.1 hli u h3 s)
  obtain ⟨z, hz⟩ := cramer_int M (fun r : Fin (2 * n) => D.coeff r) v hMv
  set e := (Mᵀ * M).det with he
  have hB : 0 < e.natAbs := Int.natAbs_pos.2 hdet
  obtain ⟨y, hy⟩ : ∃ y : κ' → ℤ, ∀ s, (y s : ℚ) = (e.natAbs : ℚ) * v s := by
    rcases Int.natAbs_eq e with h1 | h1
    · refine ⟨z, fun s => ?_⟩
      rw [hz s]
      have : (e : ℚ) = (e.natAbs : ℚ) := by
        have := congrArg (Int.cast : ℤ → ℚ) h1
        rwa [Int.cast_natCast] at this
      rw [this]
    · refine ⟨fun s => - z s, fun s => ?_⟩
      push_cast
      rw [hz s]
      have : (e : ℚ) = -(e.natAbs : ℚ) := by
        have := congrArg (Int.cast : ℤ → ℚ) h1
        rwa [Int.cast_neg, Int.cast_natCast] at this
      rw [this]
      ring
  have hMy : ∀ r : Fin (2 * n), ∑ s, M r s * y s = (e.natAbs : ℤ) * D.coeff r := by
    intro r
    apply Int.cast_injective (α := ℚ)
    simp only [Int.cast_sum, Int.cast_mul, Int.cast_natCast]
    calc ∑ s, (M r s : ℚ) * (y s : ℚ) = ∑ s, (e.natAbs : ℚ) * ((M r s : ℚ) * v s) := by
          refine sum_congr rfl fun s _ => ?_
          rw [hy s]; ring
      _ = (e.natAbs : ℚ) * ∑ s, (M r s : ℚ) * v s := by rw [← mul_sum]
      _ = _ := by rw [hMv' r]
  refine ⟨e.natAbs, hB, ?_, ?_⟩
  · -- bound
    have hgram : ∀ s s', AbsoluteValue.abs ((Mᵀ * M) s s') ≤ ((2 * n * x ^ 2 : ℕ) : ℤ) := by
      intro s s'
      simp only [Matrix.mul_apply, Matrix.transpose_apply, AbsoluteValue.abs_apply]
      refine (abs_sum_le_sum_abs _ _).trans ?_
      calc ∑ r, |M r s * M r s'| ≤ ∑ _r : Fin (2 * n), ((x : ℤ) * x) := by
            refine sum_le_sum fun r _ => ?_
            rw [abs_mul]
            exact mul_le_mul (hPco _ _) (hPco _ _) (abs_nonneg _) (Int.natCast_nonneg _)
        _ = ((2 * n * x ^ 2 : ℕ) : ℤ) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; push_cast; ring
    have hdl := Matrix.det_le (abv := AbsoluteValue.abs) hgram
    have hcard : Fintype.card κ' ≤ 2 * n := by
      have := hli.fintype_card_le_finrank
      simpa using this
    have hN : 1 ≤ 2 * n * x ^ 2 := by
      have : 1 ≤ x ^ 2 := Nat.one_le_pow _ _ hx
      nlinarith
    have h1 : e.natAbs ≤ (Fintype.card κ').factorial * (2 * n * x ^ 2) ^ Fintype.card κ' := by
      have : (e.natAbs : ℤ) ≤ ((Fintype.card κ').factorial : ℤ) * ((2 * n * x ^ 2 : ℕ) : ℤ) ^
          Fintype.card κ' := by
        rw [Int.natCast_natAbs]
        simpa [nsmul_eq_mul] using hdl
      exact_mod_cast this
    exact h1.trans (Nat.mul_le_mul (Nat.factorial_le hcard) (Nat.pow_le_pow_right hN hcard))
  · refine ⟨fun i => ∑ s, if (a s).1 = i then C (y s) * X ^ ((a s).2 : ℕ) else 0, ?_⟩
    have hV : ∑ i, (∑ s, if (a s).1 = i then C (y s) * X ^ ((a s).2 : ℕ) else 0) * Δ i =
        ∑ s, C (y s) * P (a s) := by
      simp only [Finset.sum_mul]
      rw [Finset.sum_comm]
      refine sum_congr rfl fun s _ => ?_
      simp [ite_mul, P, mul_assoc]
    rw [hV]
    ext r
    by_cases hr : r < 2 * n
    · rw [finsetSum_coeff, coeff_C_mul]
      simp only [coeff_C_mul]
      have := hMy ⟨r, hr⟩
      simp only [M] at this
      rw [← this]
      exact sum_congr rfl fun s _ => mul_comm _ _
    · have h1 : (∑ s, C (y s) * P (a s)).natDegree ≤ 2 * n - 1 := by
        refine natDegree_sum_le_of_forall_le _ _ fun s _ => ?_
        have := hPdeg (a s)
        have := (natDegree_C_mul_le (y s) (P (a s)))
        omega
      have h2 : (C (e.natAbs : ℤ) * D).natDegree ≤ n := (natDegree_C_mul_le _ _).trans hD
      rw [coeff_eq_zero_of_natDegree_lt (by omega : (∑ s, C (y s) * P (a s)).natDegree < r),
        coeff_eq_zero_of_natDegree_lt (by omega : (C (e.natAbs : ℤ) * D).natDegree < r)]

theorem effective_bezout {t : ℕ} (Δ : Fin t → ℤ[X]) (n x : ℕ) (hn : 1 ≤ n) (hx : 1 ≤ x)
    (i₀ : Fin t) (hmonic : (Δ i₀).Monic) (hdeg : ∀ i, (Δ i).natDegree ≤ n)
    (hcoeff : ∀ i j, |(Δ i).coeff j| ≤ x)
    (D : ℤ[X]) (hDdeg : D.natDegree ≤ (Δ i₀).natDegree)
    (hbez : ∃ U : Fin t → ℚ[X], toQ D = ∑ i, U i * toQ (Δ i)) :
    ∃ B : ℕ, 0 < B ∧ B ≤ (2 * n).factorial * (2 * n * x ^ 2) ^ (2 * n) ∧
      ∃ V : Fin t → ℤ[X], ∑ i, V i * Δ i = C (B : ℤ) * D := by
  obtain ⟨U, hU⟩ := hbez
  obtain ⟨W, hW, hWe⟩ := bezout_reduce Δ n hn i₀ hmonic hdeg D hDdeg U hU
  exact bezout_linalg Δ n x hn hx hdeg hcoeff D (hDdeg.trans (hdeg i₀)) W hW hWe

end RestrictedPolynomials

end
