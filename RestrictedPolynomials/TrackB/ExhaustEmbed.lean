module

public import RestrictedPolynomials.TrackB.MasterEmbedding

/-!
# Track B: `lem:exhaust-embed` (paper IV Lemma 3.4)

Paper IV `lem:exhaust-embed` (with the steps `#cyclic-factor-reduction` and
`#remove-redundant-coordinates`, covered by the one statement `exhaust_embed`), l. 1651-1657, proof L1658-1685, normalisation L1731-1733.

Route (it does not follow the source's proof). Let `G` be the subgroup of `H` generated by the images.
Since there is no non-trivial `ℤ`-embedding, every constancy functional lies in the `ℚ`-span of the
rows, so clearing denominators gives a uniform `D ≠ 0` with `D • (σ x - σ x') = 0` (and likewise for
`γ`, `φ`). With the normalisation `ZeroInImage3`, `D • σ x = 0` for every value, hence
`|G| ≤ D ^ (|X| + |Y| + |Z|)`. Uniformity in `m` is as in `bound_p_in_embed`.

Formalization choices: normalisation `ZeroInImage3`; `H` an arbitrary abelian group;
`r` before the alphabets; `G : Type` finite with `Nat.card G ≤ r`.
-/

@[expose] public section

open Finset

noncomputable section

namespace RestrictedPolynomials
namespace TrackB

/-- `zsmul` form of `int_combination_apply` for an arbitrary abelian group. -/
private theorem zsmul_int_combination {ι N H : Type*} [Fintype ι] [Fintype N] [AddCommGroup H]
    (rows : ι → N → ℤ) (c : N → ℤ) (D : ℤ) (n : ι → ℤ)
    (hid : ∀ j, D * c j = ∑ i, n i * rows i j) (v : N → H)
    (hv : ∀ i, ∑ j, rows i j • v j = 0) :
    D • ∑ j, c j • v j = 0 := by
  calc D • ∑ j, c j • v j = ∑ j, (D * c j) • v j := by
        rw [Finset.smul_sum]; exact Finset.sum_congr rfl fun j _ => by rw [mul_smul]
    _ = ∑ j, ∑ i, (n i * rows i j) • v j := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [hid j, Finset.sum_smul]
    _ = ∑ i, n i • ∑ j, rows i j • v j := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.smul_sum]
        exact Finset.sum_congr rfl fun j _ => by rw [mul_smul]
    _ = 0 := by simp [hv]

private theorem sum_indVec_smul {N H : Type*} [Fintype N] [DecidableEq N] [AddCommGroup H]
    (n₀ : N) (v : N → H) : ∑ j, indVec n₀ j • v j = v n₀ := by
  simp [indVec]

private theorem sum_rowVec_smul {X Y Z H : Type*} [Fintype X] [Fintype Y] [Fintype Z]
    [DecidableEq X] [DecidableEq Y] [DecidableEq Z] [AddCommGroup H] (s : X × Y × Z)
    (v : X ⊕ Y ⊕ Z → H) :
    ∑ j, rowVec s j • v j =
      v (Sum.inl s.1) + v (Sum.inr (Sum.inl s.2.1)) + v (Sum.inr (Sum.inr s.2.2)) := by
  simp only [rowVec, add_smul, Finset.sum_add_distrib, sum_indVec_smul]

/-- Per-instance uniform killing exponent. -/
private theorem exists_kill (X Y Z : Type) [Fintype X] [Fintype Y] [Fintype Z]
    (S : Set (X × Y × Z)) (hS : ¬ AdmitsEmbeddingInto3 S ℤ) :
    ∃ D : ℕ, 0 < D ∧ ∀ (H : Type) [AddCommGroup H] (σ : X → H) (γ : Y → H) (φ : Z → H),
      IsEmbedding3 S σ γ φ → ∀ n n' : X ⊕ Y ⊕ Z, SameKind n n' →
        D • (Sum.elim σ (Sum.elim γ φ) n - Sum.elim σ (Sum.elim γ φ) n') = 0 := by
  classical
  let N := X ⊕ Y ⊕ Z
  let rows : S → N → ℤ := fun s => rowVec s.1
  have key : ∀ q : N × N, ∃ D : ℤ, D ≠ 0 ∧ (SameKind q.1 q.2 → ∃ nn : S → ℤ,
      ∀ j, D * (indVec q.1 j - indVec q.2 j) = ∑ i, nn i * rows i j) := by
    intro q
    by_cases hk : SameKind q.1 q.2
    · have hint : ∀ v : N → ℤ, (∀ i, ∑ j, rows i j * v j = 0) →
          ∑ j, (indVec q.1 j - indVec q.2 j) * v j = 0 := by
        intro v hv
        have hv' : IsEmbedding3 S (fun x => v (Sum.inl x)) (fun y => v (Sum.inr (Sum.inl y)))
            (fun z => v (Sum.inr (Sum.inr z))) := by
          rw [isEmbedding3_iff]
          intro s hs
          have := hv ⟨s, hs⟩
          have h2 := sum_rowVec_mul (R := ℤ) s v
          simp only [Int.cast_id] at h2
          simp only [rows] at this
          rw [h2] at this
          exact this
        have hc : (∀ a b, v (Sum.inl a) = v (Sum.inl b)) ∧
            (∀ a b, v (Sum.inr (Sum.inl a)) = v (Sum.inr (Sum.inl b))) ∧
            (∀ a b, v (Sum.inr (Sum.inr a)) = v (Sum.inr (Sum.inr b))) := by
          by_contra hnc
          exact hS ((admitsEmbeddingInto3_iff S ℤ).mpr
            ⟨_, _, _, hv', (isNontrivialEmbedding3_iff _ _ _).mpr hnc⟩)
        have hv_eq : v = Sum.elim (fun a => v (Sum.inl a))
            (Sum.elim (fun a => v (Sum.inr (Sum.inl a))) fun a => v (Sum.inr (Sum.inr a))) := by
          funext n; rcases n with _ | _ | _ <;> rfl
        have := (congrFun hv_eq q.1).trans
          ((sameKind_eq_of_const _ _ _ hc q.1 q.2 hk).trans (congrFun hv_eq q.2).symm)
        simp only [sub_mul, Finset.sum_sub_distrib]
        have e1 := sum_indVec_mul (R := ℤ) q.1 v
        have e2 := sum_indVec_mul (R := ℤ) q.2 v
        simp only [Int.cast_id] at e1 e2
        rw [e1, e2, sub_eq_zero]
        exact this
      obtain ⟨D, hD, nn, hnn⟩ := exists_int_combination rows _ hint
      exact ⟨D, hD, fun _ => ⟨nn, hnn⟩⟩
    · exact ⟨1, one_ne_zero, fun h => absurd h hk⟩
  choose D hD nn hnn using key
  refine ⟨∏ q, (D q).natAbs, Finset.prod_pos fun q _ => Int.natAbs_pos.mpr (hD q), ?_⟩
  intro H _ σ γ φ hemb n n' hk
  rw [isEmbedding3_iff] at hemb
  let v : N → H := Sum.elim σ (Sum.elim γ φ)
  have hv : ∀ i : S, ∑ j, rows i j • v j = 0 := by
    intro i
    simp only [rows]
    rw [sum_rowVec_smul]
    exact hemb i.1 i.2
  have h1 := zsmul_int_combination rows (fun j => indVec n j - indVec n' j) (D (n, n'))
    (nn (n, n') hk) (hnn (n, n') hk) v hv
  simp only [sub_smul, Finset.sum_sub_distrib, sum_indVec_smul] at h1
  have h2 : (D (n, n')).natAbs • (v n - v n') = 0 := by
    rw [← natCast_zsmul]
    rcases Int.natAbs_eq (D (n, n')) with h | h
    · rw [← h]; exact h1
    · have : ((D (n, n')).natAbs : ℤ) = -D (n, n') := by omega
      rw [this, neg_smul, h1, neg_zero]
  obtain ⟨t, ht⟩ : (D (n, n')).natAbs ∣ ∏ q, (D q).natAbs :=
    Finset.dvd_prod_of_mem (fun q => (D q).natAbs) (Finset.mem_univ (n, n'))
  rw [ht, mul_comm, mul_smul, h2, smul_zero]

/-- Counting: an abelian group generated by finitely many elements killed by `D` has at most
`D ^ (number of generators)` elements. -/
private theorem card_span_le {ι H : Type} [Fintype ι] [AddCommGroup H] (v : ι → H) (D : ℕ)
    (hD : 0 < D) (hv : ∀ n, D • v n = 0) :
    Finite (Submodule.span ℤ (Set.range v)).toAddSubgroup ∧
      Nat.card (Submodule.span ℤ (Set.range v)).toAddSubgroup ≤ D ^ Fintype.card ι := by
  classical
  have : NeZero D := ⟨hD.ne'⟩
  let F : (ι → Fin D) → (Submodule.span ℤ (Set.range v)).toAddSubgroup := fun c =>
    Subtype.mk (∑ n, ((c n : ℕ)) • v n) (Submodule.sum_mem _ fun n _ =>
      nsmul_mem (Submodule.subset_span (Set.mem_range_self n)) _)
  have hF : Function.Surjective F := by
    rintro ⟨x, hx⟩
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp hx
    have hD' : (0 : ℤ) < D := by exact_mod_cast hD
    refine ⟨fun n => ⟨(c n % D).toNat, ?_⟩, ?_⟩
    · have h1 := Int.emod_nonneg (c n) hD'.ne'
      have h2 := Int.emod_lt_of_pos (c n) hD'
      omega
    · apply Subtype.ext
      show ∑ n, (((c n % D).toNat : ℕ)) • v n = ∑ n, c n • v n
      refine Finset.sum_congr rfl fun n _ => ?_
      have h1 := Int.emod_nonneg (c n) hD'.ne'
      have e : c n • v n = (D * (c n / D)) • v n + (c n % D) • v n := by
        rw [← add_smul, Int.mul_ediv_add_emod]
      have e2 : ((D : ℤ) * (c n / D)) • v n = 0 := by
        rw [mul_comm, mul_smul, natCast_zsmul, hv n, smul_zero]
      rw [e, e2, zero_add, ← natCast_zsmul, Int.toNat_of_nonneg h1]
  have hfin : Finite (Submodule.span ℤ (Set.range v)).toAddSubgroup := Finite.of_surjective F hF
  refine ⟨hfin, ?_⟩
  calc Nat.card (Submodule.span ℤ (Set.range v)).toAddSubgroup ≤ Nat.card (ι → Fin D) :=
        Nat.card_le_card_of_surjective F hF
    _ = D ^ Fintype.card ι := by
        rw [Nat.card_eq_fintype_card, Fintype.card_fun, Fintype.card_fin]

/-- Paper IV `lem:exhaust-embed` (Lemma 3.4) with the normalisation of paper IV l. 1731-1733 (`ZeroInImage3`).
`r` depends only on `m`. The group `H` is arbitrary (the source's implicit finiteness is not needed);
the group `G` of the conclusion is finite of order at most `r`. -/
theorem exhaust_embed (m : ℕ) :
    ∃ r : ℕ, ∀ (X Y Z : Type) [Fintype X] [Fintype Y] [Fintype Z],
      Fintype.card X ≤ m → Fintype.card Y ≤ m → Fintype.card Z ≤ m →
      ∀ μ : FinProb (X × Y × Z), ¬ AdmitsEmbeddingInto3 μ.support ℤ →
      ∀ (H : Type) [AddCommGroup H] (σ : X → H) (γ : Y → H) (φ : Z → H),
        IsEmbedding3 μ.support σ γ φ → ZeroInImage3 σ γ φ →
        ∃ (G : Type) (_ : AddCommGroup G), Finite G ∧ Nat.card G ≤ r ∧
          ∃ (σ' : X → G) (γ' : Y → G) (φ' : Z → G),
            IsEmbedding3 μ.support σ' γ' φ' ∧ IsLinearReduction σ' γ' φ' σ γ φ := by
  classical
  let ι := Σ abc : Fin (m + 1) × Fin (m + 1) × Fin (m + 1),
    Set (Fin abc.1.val × Fin abc.2.1.val × Fin abc.2.2.val)
  have hr : ∀ q : ι, ∃ D : ℕ, 0 < D ∧ (¬ AdmitsEmbeddingInto3 q.2 ℤ →
      ∀ (H : Type) [AddCommGroup H] (σ : Fin q.1.1.val → H) (γ : Fin q.1.2.1.val → H)
        (φ : Fin q.1.2.2.val → H),
      IsEmbedding3 q.2 σ γ φ → ∀ n n' : Fin q.1.1.val ⊕ Fin q.1.2.1.val ⊕ Fin q.1.2.2.val,
        SameKind n n' →
        D • (Sum.elim σ (Sum.elim γ φ) n - Sum.elim σ (Sum.elim γ φ) n') = 0) := by
    intro q
    by_cases hq : AdmitsEmbeddingInto3 q.2 ℤ
    · exact ⟨1, one_pos, fun h => absurd hq h⟩
    · obtain ⟨D, hD, h⟩ := exists_kill _ _ _ q.2 hq
      exact ⟨D, hD, fun _ => h⟩
  choose D hD hkill using hr
  have : Finite ι := inferInstance
  have := Fintype.ofFinite ι
  refine ⟨Finset.univ.sup fun q => D q ^ (3 * m), ?_⟩
  intro X Y Z _ _ _ hX hY hZ μ hμ H _ σ γ φ he hz
  let eX := Fintype.equivFin X
  let eY := Fintype.equivFin Y
  let eZ := Fintype.equivFin Z
  let q : ι := ⟨(⟨Fintype.card X, Nat.lt_succ_of_le hX⟩, ⟨Fintype.card Y, Nat.lt_succ_of_le hY⟩,
      ⟨Fintype.card Z, Nat.lt_succ_of_le hZ⟩),
    (fun t : X × Y × Z => (eX t.1, eY t.2.1, eZ t.2.2)) '' μ.support⟩
  have h1 : ¬ AdmitsEmbeddingInto3 q.2 ℤ := fun h =>
    hμ ((admitsEmbeddingInto3_map_iff eX eY eZ μ.support ℤ).mp h)
  have he' : IsEmbedding3 q.2 (fun x => σ (eX.symm x)) (fun y => γ (eY.symm y))
      (fun z => φ (eZ.symm z)) := by
    rw [isEmbedding3_iff] at he ⊢
    rintro _ ⟨p, hp, rfl⟩
    simpa using he p hp
  have hk := hkill q h1 H _ _ _ he'
  obtain ⟨⟨x₀, hx₀⟩, ⟨y₀, hy₀⟩, ⟨z₀, hz₀⟩⟩ := hz
  have hv : ∀ n : X ⊕ Y ⊕ Z, D q • Sum.elim σ (Sum.elim γ φ) n = 0 := by
    intro n
    rcases n with x | y | z
    · have := hk (Sum.inl (eX x)) (Sum.inl (eX x₀)) trivial
      simpa [hx₀] using this
    · have := hk (Sum.inr (Sum.inl (eY y))) (Sum.inr (Sum.inl (eY y₀))) trivial
      simpa [hy₀] using this
    · have := hk (Sum.inr (Sum.inr (eZ z))) (Sum.inr (Sum.inr (eZ z₀))) trivial
      simpa [hz₀] using this
  obtain ⟨hfin, hcard⟩ := card_span_le (Sum.elim σ (Sum.elim γ φ)) (D q) (hD q) hv
  set K : AddSubgroup H :=
    (Submodule.span ℤ (Set.range (Sum.elim σ (Sum.elim γ φ)))).toAddSubgroup with hK
  have hmem : ∀ n : X ⊕ Y ⊕ Z, Sum.elim σ (Sum.elim γ φ) n ∈ K := fun n =>
    Submodule.subset_span (Set.mem_range_self n)
  refine ⟨K, inferInstance, hfin, ?_, fun x => ⟨σ x, hmem (Sum.inl x)⟩,
    fun y => ⟨γ y, hmem (Sum.inr (Sum.inl y))⟩, fun z => ⟨φ z, hmem (Sum.inr (Sum.inr z))⟩,
    ?_, ?_⟩
  · refine hcard.trans ?_
    have hc : Fintype.card (X ⊕ Y ⊕ Z) ≤ 3 * m := by
      simp only [Fintype.card_sum]; omega
    calc D q ^ Fintype.card (X ⊕ Y ⊕ Z) ≤ D q ^ (3 * m) := Nat.pow_le_pow_right (hD q) hc
      _ ≤ _ := Finset.le_sup (f := fun q => D q ^ (3 * m)) (Finset.mem_univ q)
  · rw [isEmbedding3_iff] at he ⊢
    intro p hp
    apply Subtype.ext
    exact he p hp
  · exact ⟨K.subtype, K.subtype, K.subtype, K.subtype_injective, K.subtype_injective,
      K.subtype_injective, fun x => rfl, fun y => rfl, fun z => rfl⟩

/-- weaker corollary of `exhaust_embed` (same `r`): here `r` may depend on the alphabets `X Y Z`, not
only on `m`. The source's own order (`∀ m ∃ r ∀ Σ Γ Φ`) is the one of `exhaust_embed`. -/
theorem exhaust_embed_literal (m : ℕ) (X Y Z : Type) [Fintype X] [Fintype Y] [Fintype Z]
    (hX : Fintype.card X ≤ m) (hY : Fintype.card Y ≤ m) (hZ : Fintype.card Z ≤ m) :
    ∃ r : ℕ, ∀ μ : FinProb (X × Y × Z), ¬ AdmitsEmbeddingInto3 μ.support ℤ →
      ∀ (H : Type) [AddCommGroup H] (σ : X → H) (γ : Y → H) (φ : Z → H),
        IsEmbedding3 μ.support σ γ φ → ZeroInImage3 σ γ φ →
        ∃ (G : Type) (_ : AddCommGroup G), Finite G ∧ Nat.card G ≤ r ∧
          ∃ (σ' : X → G) (γ' : Y → G) (φ' : Z → G),
            IsEmbedding3 μ.support σ' γ' φ' ∧ IsLinearReduction σ' γ' φ' σ γ φ := by
  obtain ⟨r, hr⟩ := exhaust_embed m
  exact ⟨r, fun μ hμ H _ σ γ φ he hz => hr X Y Z hX hY hZ μ hμ H σ γ φ he hz⟩

end TrackB
end RestrictedPolynomials
